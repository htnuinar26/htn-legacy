# HTN Legacy - Environment Variables (EXAMPLE)
# Salin file ini ke .env dan isi dengan nilai produksi/staging yang sebenarnya.
# JANGAN commit file .env yang berisi secret asli.

# --- Database ---------------------------------------------------
# Produksi: PostgreSQL Neon.
#   DATABASE_URL  = Neon pooler (dipakai Prisma Client saat runtime)
#   DIRECT_URL    = Neon direct (dipakai perintah prisma migrate)
# Pengembangan lokal dapat memakai SQLite melalui konfigurasi terpisah.
DATABASE_URL="file:../db/custom.db"
DIRECT_URL="file:../db/custom.db"

# --- Auth / Session --------------------------------------------
# Secret untuk menandatangani JWT sesi (anggota & admin).
# Ganti dengan string acak minimal 32 byte di produksi.
JWT_SECRET="change-me-to-a-long-random-secret"

# Password bersama untuk login Admin/Bendahara.
# Di produksi, simpan di secret manager, bukan file ini.
ADMIN_PASSWORD="change-me-admin-password"

# Empat nama Admin yang dapat dipilih saat login, dipisahkan koma.
ADMIN_NAMES="Admin Satu,Admin Dua,Admin Tiga,Admin Empat"

# Kunci enkripsi AES-256-GCM untuk password anggota.
# Harus 64 hex chars (32 bytes). Generate dengan: openssl rand -hex 32
# JANGAN ganti setelah ada anggota terdaftar (password tidak bisa didekripsi).
ENCRYPTION_KEY="generate-with-openssl-rand-hex-32"

# --- Storage (Supabase) ----------------------------------------
# Storage production wajib memakai Supabase Storage. Kredensial hanya dipakai
# di server dan tidak boleh masuk ke client atau repository.
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="htn-legacy-receipts"

# --- App --------------------------------------------------------
# Nama instance yang tampil di UI (top bar dan halaman login).
NEXT_PUBLIC_INSTANCE_NAME="HTN Legacy"

# 1 untuk debug proxy, 0 untuk normal.
DEBUG_MW="0"

NODE_ENV="development"
